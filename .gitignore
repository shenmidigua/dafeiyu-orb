# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
out/
*.tsbuildinfo
.turbo/
.cache/

# Compiled from packages/*/src by `pnpm build` — never hand-edited
packages/*/lib/
packages/helper/assets/vendor/

# Package artifacts
*.tgz
*.tgz.bak-*

# Electron helper runtime (downloaded, not vendored)
.electron/
electron-cache/

# Native modules
*.node
native/**/build/
packages/native-selection/build/

# Environment and secrets
.env
.env.*
!.env.example
*.pem
credentials.json

# Logs and coverage
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
coverage/

# OS
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*~

# Local agent / tooling state
.cursor/
.zcode/
.zcodeignore

# Assembled by packages/bundle/scripts/assemble.mjs
packages/bundle/lib/
packages/bundle/client.js

# assemble.mjs leaves the previous build behind as a dot-prefixed copy inside the
# output root (retired is mkdtemp'd *inside* outRoot). Each rebuild adds one more.
packages/bundle/.retired-*/
packages/bundle/.assemble-*/

# Scratch dirs from probing the DSH asar
_asar_probe/

# Local verification leftovers (dsh_orb/ holds the real wake-word training tools)
dsh_orb/__pycache__/
dsh_orb/*.log
dsh_orb/*.jsonl
# Measurement output from the probes. The probes themselves are kept — they are what ruled out
# noise and splice artefacts — but their numbers belong to one machine's run.
dsh_orb/noise-probe.json
dsh_orb/splice-probe.json
dsh_orb/rateprobe/
dsh_orb/whichword/
_probe*.mjs

# Audio captured by the wake-word probes, and the traces the ball emits while one runs. Both are
# run output, not inputs: they are re-recorded on demand and are meaningless on another machine.
dsh_orb/*.wav
dsh_orb/trace-*.json
dsh_orb/trace-*.txt
dsh_orb/meter-*.txt
dsh_orb/meter-*.png
dsh_orb/proc-start.txt
dsh_orb/wake-meter-*.png
dsh_orb/wake-mic-*.wav
dsh_orb/.synth-mark.json

# Per-file backups taken before a loop extension was stripped (dsh_orb/make_oneshot.py).
# The originals are in the same pack directory, so these only add weight.
大肥鱼表情包整合/**/*.bak-loop-*

# Superseded wake-word checkpoints, kept locally while a retrain is in flight.
dsh-voice-dialog/assets/*.onnx.*.bak

# onnxruntime-web runtime (MIT, fetched from CDN — not source)
dsh-voice-dialog/assets/ort/
dsh-voice-dialog/logs/
